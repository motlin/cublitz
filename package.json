{
	"name": "cublitz",
	"version": "0.0.0",
	"private": true,
	"description": "A rolling paint puzzle",
	"type": "module",
	"scripts":
	{
		"preinstall": "npx only-allow pnpm",
		"dev": "vp dev",
		"preview": "vp preview",
		"build": "vp build",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "oxfmt-next-line",
		"fmt:ci": "oxfmt-next-line --check",
		"fallow": "fallow fix --yes --no-create-config",
		"fallow:ci": "fallow dead-code",
		"typecheck": "tsc --noEmit",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:browser": "vp build && playwright test",
		"deploy": "wrangler pages deploy --branch main",
		"prepare": "VITE_GIT_HOOKS=0 vp config"
	},
	"devDependencies":
	{
		"@playwright/test": "1.64.1",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "catalog:",
		"fallow": "^3.38.1",
		"jsdom": "^30.1.3",
		"markdownlint-cli2": "^0.24.0",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.157.0"
	},
	"packageManager": "pnpm@12.12.1"
}

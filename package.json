{
	"name": "cublitz",
	"version": "0.0.0",
	"private": true,
	"description": "A rolling paint puzzle",
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite",
		"preview": "vite preview",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint .",
		"test:unit": "vitest run",
		"test:browser": "vite build && playwright test",
		"golden": "node scripts/generate-golden.ts",
		"prove-harness": "node scripts/prove-harness.ts",
		"deploy": "wrangler pages deploy --branch main"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "5.0.5",
		"jsdom": "^30.1.3",
		"oxlint": "^1.90.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.0"
	},
	"packageManager": "pnpm@12.7.0"
}

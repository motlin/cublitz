{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {"correctness": "error"},
	"plugins": ["typescript", "unicorn", "oxc", "import"],
	"rules": {
		"typescript/no-explicit-any": "error",
		"no-unused-vars": "error"
	},
	"overrides": [
		{"files": ["tests/browser/harness/**"], "rules": {"no-setter-return": "off"}},
		{"files": ["scripts/prove-harness.ts"], "rules": {"no-control-regex": "off"}}
	],
	"ignorePatterns": ["legacy/**", "dist/**", "node_modules/**", "test-results/**"]
}
